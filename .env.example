# Optional: leave blank to run in local rule-based demo mode.
# For real LLM answers and automatic function calling, add a Gemini API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional local paths (relative paths are resolved from the repository root)
EDUDESK_DB_PATH=data/edudesk.db
EDUDESK_UPLOAD_DIR=data/uploads
EDUDESK_MAX_UPLOAD_MB=10

# Streamlit connects to this FastAPI address
EDUDESK_API_URL=http://127.0.0.1:8000
